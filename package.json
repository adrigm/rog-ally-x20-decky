{
  "name": "ally-system-control",
  "version": "0.1.0-alpha.1",
  "description": "Control de volumen, silencio y brillo de Windows desde Decky en la ROG Ally.",
  "type": "module",
  "author": "adrigm",
  "license": "BSD-3-Clause",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test:frontend": "node --import ./tests/frontend/register.mjs --test tests/frontend/*.test.mjs"
  },
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "4.53.3",
    "typescript": "5.6.2"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "tslib": "2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"]
    }
  }
}
